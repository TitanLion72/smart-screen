{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$hovered": "$hue.neutral.100",
          "$focused": "$hue.neutral.100",
          "$pressed": "$hue.neutral.100"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$text.base",
          "$pressed": "$text.base"
        },
        "destructive": {
          "base": "$hue.red.400",
          "$hovered": "$hue.red.300",
          "$focused": "$hue.red.300",
          "$pressed": "$hue.red.300"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.neutral.300",
        "$focused": "$hue.neutral.300",
        "$pressed": "$hue.neutral.300"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.orange.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.cyan.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.neutral.700",
          "$pressed": "$hue.neutral.700"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.800"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.600"
    },
    "scrollbar": {
      "base": "$hue.neutral.600"
    },
    "diff": {
      "text": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400",
        "context": "$text.muted",
        "hunkHeader": "$hue.blue.400"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$background.base"
      },
      "highlight": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.500",
      "keyword": "$hue.purple.400",
      "function": "$hue.blue.400",
      "variable": "$text.base",
      "string": "$hue.green.400",
      "number": "$hue.orange.400",
      "type": "$hue.cyan.400",
      "operator": "$hue.neutral.400",
      "punctuation": "$text.muted"
    },
    "markdown": {
      "text": "$text.base",
      "heading": "$hue.accent.400",
      "link": "$hue.blue.400",
      "linkText": "$hue.blue.300",
      "code": "$hue.orange.400",
      "blockQuote": "$text.muted",
      "emphasis": "$text.base",
      "strong": "$hue.accent.300",
      "horizontalRule": "$hue.neutral.600",
      "listItem": "$hue.accent.400",
      "listEnumeration": "$hue.accent.400",
      "image": "$text.base",
      "imageText": "$text.muted",
      "codeBlock": "$hue.cyan.400"
    },
    "hue": {},
    "categorical": [
      "orange",
      "blue",
      "green",
      "yellow",
      "purple",
      "cyan",
      "orange",
      "red"
    ],
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
